# ── LLM (pick one — the agent uses whichever is set) ──────────────────────────
# Option A: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Option B: OpenAI GPT-4o (fallback)
# OPENAI_API_KEY=sk-YOUR_KEY_HERE

# ── TigerGraph Savanna (REQUIRED for full submission) ─────────────────────────
